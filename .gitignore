*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv
*.egg-info/
dist/
build/

# Local configuration
*.local
.env
secrets/

# Backup files
*.backup
*.bak
*.old

# Logs
*.log

# Temporary files
tmp/
temp/
.tmp/

# OS specific
.Trash-*/
.nfs*
