# Warp Shell - Zsh Configuration
# =================================

# Path configuration
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# Editor configuration
export EDITOR="nvim"
export VISUAL="nvim"

# History configuration
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY

# Basic options
setopt AUTO_CD
setopt CORRECT
setopt INTERACTIVE_COMMENTS

# Completion system
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ============================================
# MODERN CLI TOOLS INTEGRATION
# ============================================

# Starship prompt
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# fzf integration
if [ -f ~/.fzf.zsh ]; then
    source ~/.fzf.zsh
fi

# zoxide (smart cd)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# atuin (advanced history)
if command -v atuin &> /dev/null; then
    eval "$(atuin init zsh)"
fi

# mise (version manager)
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
fi

# ============================================
# ALIASES
# ============================================

# Modern replacements
alias cat='bat'
alias ls='eza'
alias ll='eza -alh --git'
alias l='eza -lh'
alias tree='eza --tree'
alias grep='rg'
alias find='fd'
alias top='btop'

# Vim/Neovim
alias v='nvim'
alias vim='nvim'

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glg='git log --oneline --graph --decorate'
alias lg='lazygit'

# Docker shortcuts
alias d='docker'
alias dc='docker compose'
alias ld='lazydocker'

# Zellij
alias zj='zellij'
alias zj-dev='zellij --layout dev'
alias zj-ops='zellij --layout ops'

# Terraform/Terragrunt
alias tf='terraform'
alias tg='terragrunt'

# Kubernetes
alias k='kubectl'
alias kx='kubectx'
alias kns='kubens'

# Utils
alias c='clear'
alias update='sudo apt update && sudo apt upgrade -y'
alias reload='source ~/.zshrc'

# ============================================
# FUNCTIONS
# ============================================

# Quick directory navigation
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract any archive
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Git commit with commitizen
gcommit() {
    cz commit
}

# ============================================
# WARP SHELL SPECIFIC
# ============================================

# Load machine-specific config
if [ -f ~/.config/warp-shell/machine.conf ]; then
    source ~/.config/warp-shell/machine.conf
fi

# Load local customizations (not versioned)
if [ -f ~/.zshrc.local ]; then
    source ~/.zshrc.local
fi

# Welcome message
if command -v neofetch &> /dev/null; then
    neofetch
fi
