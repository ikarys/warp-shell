// Warp Shell - Zellij Configuration
// ===================================

// Theme
theme "cyberpunk"

// UI
simplified_ui true
pane_frames true
default_layout "compact"

// Copy mode
copy_command "wl-copy"
copy_on_select true

// Mouse
mouse_mode true
scroll_buffer_size 10000

// Session
session_serialization false
pane_viewport_serialization false
scrollback_lines_to_serialize 0

// Keybindings (using defaults)
// Press F1 for help
// Ctrl+p -> Pane mode
// Ctrl+t -> Tab mode
// Ctrl+s -> Scroll mode
// Ctrl+q -> Quit

// Mirror session
mirror_session false

// Auto-layout
auto_layout true

// Scrollback editor
scrollback_editor "nvim"
