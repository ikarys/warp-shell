# Ghostty — Warp Shell configuration
# =====================================

# Theme (installed by just install-theme)
theme = cyberpunk

# Font — requires JetBrains Mono Nerd Font
# Download: https://www.nerdfonts.com/font-downloads
font-family = JetBrains Mono Nerd Font
font-size = 13

# Cursor
cursor-style = block
cursor-style-blink = true

# Shell
command = /usr/bin/fish
shell-integration = fish
shell-integration-features = cursor,sudo,title

# Window
window-decoration = true
window-padding-x = 10
window-padding-y = 8
background-opacity = 0.92
background-blur-radius = 20

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# Keybindings
# Copy: sélectionner du texte le copie automatiquement (copy-on-select)
# Ctrl+C est conservé pour SIGINT (kill process)
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
